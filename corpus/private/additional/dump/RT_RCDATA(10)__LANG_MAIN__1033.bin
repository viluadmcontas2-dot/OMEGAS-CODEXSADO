    {
      "id": "LABELADATTANOTA1",
      "ita": "se carburazione magra allora correttori positivi",
      "eng": "if lean carburetion then positive fuel trims",
      "fra": "si carburation maigre correcteurs positifs",
      "deu": "bei magerem Gemisch positive Korrektoren",
      "spa": "si carburación pobre, correctores positivos",
      "por": "se carburação fraca então compensações positivas",
      "pol": "jeśli karburyzacja mieszanki ubogiej, to dodatnie trymery",
      "ned": "als arm mengsel dan positieve trimmers",
      "hun": "ha a karburálás gyenge, akkor pozitív csökkentő",
      "rom": "dacă carburaţia este slabă atunci corectori pozitivi",
      "far": "اگر کربندهی خشک است بنابراین تصحیح کننده ها مثبت",
      "rus": "обедненная смесь при полож. знач. тример",
      "tur": "karbürasyon zayıf ise, bu durumda pozitif trimmerler",
      "heb": "אם קרבורציה ענייה אז מקזזים חיוביים",
      "bul": "ако е бедна сместа - позитивни тримове",
